{
  "name": "Drift demo — Rust",
  "image": "mcr.microsoft.com/devcontainers/rust:1-1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },

  // Drift's Rust surface diff shells out to `cargo public-api`, which reads
  // rustdoc's JSON output and therefore hard-requires the nightly toolchain.
  // Drift can install both itself (`tools.autoInstall` defaults to true), but
  // that happens lazily during the first analysis and `cargo install
  // cargo-public-api` compiles from source — several minutes with the panel
  // sitting empty. Provisioning them at creation time keeps the demo
  // deterministic and puts the wait in the Codespace build instead.
  //
  // Both are pinned so the demo does not change underneath us.
  "onCreateCommand": ".devcontainer/cargo/setup.sh",
  "waitFor": "onCreateCommand",

  "customizations": {
    "vscode": {
      "extensions": ["drift.drift"],
      "settings": {
        "drift.session.mode": "ask",
        "drift.analysis.runOnStartup": true,
        "files.exclude": {
          "demos/npm": true,
          "demos/pypi": true,
          "demos/go": true,
          "demos/maven": true
        }
      }
    },
    "codespaces": {
      "openFiles": ["demos/cargo/DEMO.md", "demos/cargo/src/main.rs", "demos/cargo/Cargo.toml"]
    }
  }
}
