# Node
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
*.swp

# Dependency install / build output created inside a Codespace. The demos are
# committed at their pre-upgrade baseline; anything a package manager or build
# produces at runtime is never committed.
demos/**/node_modules/
demos/**/.venv/
demos/**/venv/
demos/**/__pycache__/
demos/**/*.pyc
demos/**/target/
demos/**/dist/
demos/**/build/
demos/**/bin/
demos/**/obj/
demos/**/.gradle/
demos/**/vendor/

# Lockfiles a demo's setup step writes. The demos pin exact versions in their
# manifests, so nothing is committed here — and an untracked lockfile would
# otherwise show up in the `git status` that DEMO.md points at to prove only
# the manifest changed.
demos/**/package-lock.json
demos/**/Cargo.lock
demos/**/Gemfile.lock
demos/**/composer.lock
demos/**/mix.lock
demos/**/pubspec.lock
demos/**/Package.resolved
demos/**/Podfile.lock
demos/**/packages.lock.json

# Go demo build binary
demos/go/drift-demo-go

# Oracle virtualenvs created by scripts/verify-oracle.mjs
demos/**/.drift-demo/.venv/
